rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function inFamily(familyId) {
      return signedIn() && request.auth.token.familyId == familyId;
    }

    match /families/{familyId} {
      allow read: if inFamily(familyId);
      allow write: if false;

      match /billing/{docId} {
        allow read: if inFamily(familyId);
        allow write: if false;
      }

      match /settings/{docId} {
        allow read, write: if false;
      }

      match /users/{uid} {
        allow read: if inFamily(familyId);
        allow write: if false;
      }

      match /tasks/{taskId} {
        allow read: if inFamily(familyId);
        allow delete: if inFamily(familyId);
        allow create, update: if inFamily(familyId)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200
          && request.resource.data.assignedTo is string
          && request.resource.data.completed is bool;
      }

      match /daily_stats/{statsId} {
        allow read: if inFamily(familyId);
        allow write: if false;
      }

      match /cron_runs/{runId} {
        allow read: if inFamily(familyId);
        allow write: if false;
      }

      match /reset_config/{docId} {
        allow read, write: if inFamily(familyId);
      }

      match /referral/{docId} {
        allow read: if inFamily(familyId);
        allow write: if false;
      }
    }

    match /family_members/{uid} {
      allow read, write: if false;
    }

    match /stripe_customers/{customerId} {
      allow read, write: if false;
    }

    match /signup_codes/{id} {
      allow read, write: if false;
    }

    match /referrals/{familyId} {
      allow read, write: if false;
    }

    /* legal_identity stays unreadable. Monthly winner is public-read names+count only. */
    match /platform/{docId} {
      allow read: if docId.matches('referral_month_[0-9]{4}-[0-9]{2}');
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
