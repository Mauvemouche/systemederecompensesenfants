rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function billingDoc() {
      return get(/databases/$(database)/documents/billing/current).data;
    }

    function isOwner() {
      return signedIn()
        && exists(/databases/$(database)/documents/billing/current)
        && billingDoc().ownerUid == request.auth.uid;
    }

    function hasPaidAccess() {
      return isOwner() && billingDoc().status in ['trialing', 'active', 'past_due'];
    }

    match /billing/{docId} {
      allow read: if isOwner();
      allow write: if false;
    }

    match /family_config/{docId} {
      allow read: if isOwner();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /tasks/{taskId} {
      allow read: if hasPaidAccess();
      allow delete: if hasPaidAccess();
      allow create, update: if hasPaidAccess()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.assignedTo is string
        && request.resource.data.completed is bool;
    }

    match /daily_stats/{statsId} {
      allow read: if hasPaidAccess();
      allow write: if false;
    }

    match /cron_runs/{runId} {
      allow read: if isOwner();
      allow write: if false;
    }
  }
}
