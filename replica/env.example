# Test project recompenses-test (sandbox only):
# firebase functions:secrets:set STRIPE_SECRET_KEY --project recompenses-test
# firebase functions:secrets:set STRIPE_WEBHOOK_SECRET --project recompenses-test
# firebase functions:secrets:set STRIPE_PRICE_MONTHLY --project recompenses-test
# firebase functions:secrets:set STRIPE_PRICE_YEARLY --project recompenses-test
#
# Live project kidsrewardsystem: set AnthonyRsca LIVE keys + live price IDs via
# firebase functions:secrets:set … --project kidsrewardsystem
# Never copy sk_test onto kidsrewardsystem. Do not write live values here.
#
# Mail + operator identity (Secret Manager; survives functions deploy).
# Do not use gcloud run services update --update-env-vars after each deploy.
# firebase functions:secrets:set EMAIL_USER --project recompenses-test
# firebase functions:secrets:set EMAIL_PASSWORD --project recompenses-test
# firebase functions:secrets:set EMAIL_FROM --project recompenses-test
# firebase functions:secrets:set EMAIL_REPLY_TO --project recompenses-test
# firebase functions:secrets:set EMAIL_SMTP_HOST --project recompenses-test
